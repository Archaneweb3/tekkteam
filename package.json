{
  "name": "tekkwork-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server:launch": "node server/pump-launch-index.js",
    "test:pump-launch": "node --test tests/pump-launch.test.mjs tests/pump-readiness.test.mjs tests/pump-simulation-policy.test.mjs tests/initial-buy.test.mjs",
    "server": "node server/index.js",
    "test:backend": "node --test tests/backend.test.mjs tests/chain.test.mjs tests/wallet-send.test.mjs",
    "test:mainnet-safety": "node --test tests/mainnet-safety.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
