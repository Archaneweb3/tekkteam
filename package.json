    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "lucide": "^1.48.0",
    "sharp": "^0.35.4",
    "three": "^0.180.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^7.1.0"
  }
