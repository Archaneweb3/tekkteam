# Development only. Use a persistent server for the API, never a public frontend env.
PORT=4190
CHAIN_MODE=local
# Explicit network selection overrides legacy CHAIN_MODE: DEVNET or MAINNET.
# SOLANA_NETWORK=MAINNET
# MAINNET_SAFETY_MODE=true
# SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# MAINNET uses an isolated server/data/mainnet-safety directory by default.
# Never copy Devnet databases/mints/accounts or place private RPC/signing secrets in VITE_*.
APP_ORIGINS=http://127.0.0.1:5188,http://localhost:5188
DATA_DIR=server/data
# For real test-token issuance: CHAIN_MODE=devnet and a devnet RPC.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# Production requires a base64-encoded 32-byte key, stored in a secret manager.
# VAULT_KEY_BASE64=
LIVE_TRADING_ENABLED=false
GLOBAL_TRADING_KILL_SWITCH=true
FUNDING_ENABLED=false
# Independent Paper emergency stop; the Live kill switch does not stop Paper.
PAPER_TRADING_KILL_SWITCH=false
