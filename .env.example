# Development only. Use a persistent server for the API, never a public frontend env.
PORT=4190
CHAIN_MODE=local
APP_ORIGINS=http://127.0.0.1:5188,http://localhost:5188
DATA_DIR=server/data
# For real test-token issuance: CHAIN_MODE=devnet and a devnet RPC.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# Production requires a base64-encoded 32-byte key, stored in a secret manager.
# VAULT_KEY_BASE64=
